# 鏈湴寮€鍙戠幆澧冮厤缃ず渚?
# 浣跨敤璇存槑锛氬皢姝ゆ枃浠跺鍒朵负 application-local.yml锛屽苟濉啓瀹為檯鐨?API Key

spring:
  mail:
    host: ${MAIL_HOST:smtp.qq.com}
    port: ${MAIL_PORT:465}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
    properties:
      mail.smtp.auth: true
      mail.smtp.ssl.enable: true
  # Spring AI Alibaba 閰嶇疆
  ai:
    alibaba:
      dashscope:
        api-key: your-dashscope-api-key  # 璇峰湪 https://bailian.console.aliyun.com/?apiKey=1&tab=api#/api 鑾峰彇

# Pexels API 閰嶇疆
pexels:
  api-key: ${PEXELS_API_KEY:xxx}
# Nano Banana (Gemini 鍘熺敓鍥剧墖鐢熸垚) 閰嶇疆
nano-banana:
  api-key: xxx  # 璇峰湪 https://aistudio.google.com/apikey 鑾峰彇
  model: gemini-3-pro-image-preview  # 鍙€? gemini-2.5-flash-image (蹇€?, gemini-3-pro-image-preview (楂樿川閲?
  aspect-ratio: "16:9"  # 鍙€夛紝鏀寔 1:1, 2:3, 3:2, 3:4, 4:3, 4:5, 5:4, 9:16, 16:9, 21:9
  image-size: "1K"  # 鍙€夛紙浠?gemini-3-pro 鏀寔锛夛紝鏀寔 1K, 2K, 4K
  output-mime-type: image/png  # 鍙€夛紝鏀寔 image/jpeg, image/png

# Nano Banana锛坅piclaude Gemini 鍏煎鎺ュ彛锛?nano-banana-apiclaude:
  api-key: ${NANO_BANANA_APICLAUDE_API_KEY:}
  base-url: ${NANO_BANANA_APICLAUDE_BASE_URL:https://apiclaude.cc}
  model: ${NANO_BANANA_APICLAUDE_MODEL:gemini-3-pro-image-preview}
  aspect-ratio: ${NANO_BANANA_APICLAUDE_ASPECT_RATIO:16:9}
  image-size: ${NANO_BANANA_APICLAUDE_IMAGE_SIZE:1K}

# GPT Image 2锛坅piclaude OpenAI 鍏煎鎺ュ彛锛?image-2:
  api-key: ${IMAGE_2_API_KEY:}
  base-url: ${IMAGE_2_BASE_URL:https://apiclaude.cc}
  model: ${IMAGE_2_MODEL:gpt-image-2}
  size: ${IMAGE_2_SIZE:1024x1024}
  n: ${IMAGE_2_N:1}

# Mermaid 鍥捐〃鐢熸垚閰嶇疆
mermaid:
  cli-command: mmdc  # CLI 鍛戒护锛圵indows 涓嬩細鑷姩浣跨敤 mmdc.cmd锛?
  background-color: transparent  # 鑳屾櫙棰滆壊
  output-format: svg  # 杈撳嚭鏍煎紡锛坰vg/png/pdf锛?
  width: 1200  # 鍥剧墖瀹藉害锛堝儚绱狅級
  timeout: 30000  # 鍛戒护鎵ц瓒呮椂鏃堕棿锛堟绉掞級

# Iconify 鍥炬爣搴撻厤缃?
iconify:
  api-url: https://api.iconify.design
  search-limit: 10
  default-height: 64
  default-color: ""  # 鐣欑┖浣跨敤 currentColor锛屾垨璁剧疆濡?"#000000"

# 琛ㄦ儏鍖呭浘鐗囨绱㈤厤缃?
emoji-pack:
  search-url: https://cn.bing.com/images/async
  suffix: 鐔婄尗澶磋〃鎯呭寘
  timeout: 10000  # 璇锋眰瓒呮椂锛堟绉掞級

# SVG 姒傚康绀烘剰鍥剧敓鎴愰厤缃?
svg-diagram:
  default-width: 800
  default-height: 600
  folder: svg-diagrams  # COS 瀛樺偍鏂囦欢澶?

# Stripe 鏀粯閰嶇疆锛堟祴璇曟ā寮忥級
stripe:
  api-key: sk_test_your_stripe_secret_key  # 璇峰湪 https://dashboard.stripe.com/test/apikeys 鑾峰彇
  webhook-secret: whsec_your_webhook_secret  # Webhook 绛惧悕瀵嗛挜
  success-url: http://localhost:5173/vip?success=true  # 鏀粯鎴愬姛鍥炶皟 URL
  cancel-url: http://localhost:5173/vip?cancelled=true  # 鏀粯鍙栨秷鍥炶皟 URL

# 鑵捐浜?COS 閰嶇疆锛堝彲閫夛紝MVP 闃舵鍙互涓嶉厤缃級
tencent:
  cos:
    secret-id: your-secret-id
    secret-key: your-secret-key
    region: ap-guangzhou
    bucket: your-bucket
